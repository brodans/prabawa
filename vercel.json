{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "functions": {
    "api/billing-aktivasi.js":  { "maxDuration": 60 },
    "api/panel-auth.js":        { "maxDuration": 60 },
    "api/rpc.js":               { "maxDuration": 60 },
    "api/upload.js":            { "maxDuration": 60 },
    "api/health.js":            { "maxDuration": 30 },
    "api/midtrans-charge.js":   { "maxDuration": 30 },
    "api/ocr.js":               { "maxDuration": 30, "memory": 1024, "includeFiles": "api/model/**" },
    "api/ep.js":                { "maxDuration": 30 }
  },
  "routes": [
    { "src": "^/ep(/.*)?$",     "dest": "/api/ep" },
    { "handle": "filesystem"   },
    { "src": "^/(.*)$",        "dest": "/index.html" }
  ]
}
